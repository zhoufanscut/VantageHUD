# Runtime render cache (regenerated per session, scoped per machine)
cache/

# Personal HUD config — copy config.json.example → config.json and edit.
# Per-install/personal; the committed .example is the canonical reference.
/config.json

# Logs / scratch
*.log
*.tmp

# Legacy per-project state dirs from older HUD versions (runtime files now live
# in cache/ above, overridable via HUD_CACHE_DIR). Matched at any depth.
.claude-statusline/

# Local agent tooling scratch
.claude/
.omo/
